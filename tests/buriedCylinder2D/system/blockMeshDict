FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2D channel (x-z, one cell across) with a floor patch one cell layer below
// the initial bed z_b = 0 at t = 0 and 30 mm below the deepest bed of the run; 5 mm cells.

scale   1;

vertices
(
    (0 0 -0.08) (0.4 0 -0.08) (0.4 0.005 -0.08) (0 0.005 -0.08)
    (0 0 0.1)   (0.4 0 0.1)   (0.4 0.005 0.1)   (0 0.005 0.1)
);

blocks ( hex (0 1 2 3 4 5 6 7) (80 1 36) simpleGrading (1 1 1) );

edges ();

boundary
(
    bottom { type patch; faces ((0 3 2 1)); }
    top    { type patch; faces ((4 5 6 7)); }
    inlet  { type patch; faces ((0 4 7 3)); }
    outlet { type patch; faces ((1 2 6 5)); }
    sides  { type patch; faces ((0 1 5 4) (3 7 6 2)); }
);


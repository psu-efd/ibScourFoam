FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 0.2 x 0.2 m box, 5 mm cells; the floor patch lies 5 cm below the bed

scale   1;

vertices
(
    (-0.1 -0.1 -0.05) (0.1 -0.1 -0.05) (0.1 0.1 -0.05) (-0.1 0.1 -0.05)
    (-0.1 -0.1  0.05) (0.1 -0.1  0.05) (0.1 0.1  0.05) (-0.1 0.1  0.05)
);

blocks ( hex (0 1 2 3 4 5 6 7) (40 40 20) simpleGrading (1 1 1) );

edges ();

boundary
(
    bottom { type patch; faces ((0 3 2 1)); }
    top    { type patch; faces ((4 5 6 7)); }
    inlet  { type patch; faces ((0 4 7 3)); }
    outlet { type patch; faces ((1 2 6 5)); }
    sides  { type patch; faces ((0 1 5 4) (3 7 6 2)); }
);


FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    p { solver GAMG; smoother GaussSeidel; tolerance 0; relTol 0.01; }
    pFinal { $p; tolerance 1e-6; relTol 0; }
    "(U|k|omega)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-5; relTol 0.1; }
    "(U|k|omega)Final" { $U; relTol 0; }
}
PIMPLE
{
    nOuterCorrectors 1;
    nCorrectors     3;
    nNonOrthogonalCorrectors 1;
    pRefCell        0;
    pRefValue       0;
}

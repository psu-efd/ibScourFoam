FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      immersedBoundaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Bed-level input test: the flow is not solved and the bed shear is zero, so
// the bed keeps its initial level. The initial bed (and the non-erodible
// floor) come from constant/bedInput, a copy of one of inputs/bedInput.*.

solveFlow       false;

bed
{
    type            heightField;
    floorPatch      bottom;
    openBoundaries  (inlet outlet);

    #include        "$FOAM_CASE/constant/bedInput"

    grainDiameter   0.00026;
    specificGravity 2.65;
    porosity        0.4;
    gravity         9.81;
    criticalShields 0.05;
    frictionCoefficient 0.625;
    bedLoad         engelundFredsoe;

    morphStartTime  0;
    morphFactor     1;
    maxBedChange    1e-3;
    updateDistance  1e-3;

    sandSlide       true;

    prescribedShear
    {
        type        expression;
        expression  #{ vector(0, 0, 0) #};
    }

    seepage
    {
        type        none;
    }
}

cutFaces        true;
wallSink        tangential;

solids
{
}

wallModel
{
    mode            stress;
    wallLaw
    {
        type            vanDriest;
        ks              0.0005;
    }
}


// Flat channel 0.4 x 0.2 m, floor patch 'bottom' at z = -0.05 (one cell
// layer of sand below the bed at z = 0, so that the bed cuts the mesh and
// the first layer above it holds the IB cells), water to z = 0.1
scale   1;
vertices
(
    (0 0 -0.05) (0.4 0 -0.05) (0.4 0.2 -0.05) (0 0.2 -0.05)
    (0 0 0.1) (0.4 0 0.1) (0.4 0.2 0.1) (0 0.2 0.1)
);
blocks ( hex (0 1 2 3 4 5 6 7) (8 4 3) simpleGrading (1 1 1) );
edges ();
boundary
(
    bottom { type patch; faces ((0 3 2 1)); }
    top    { type patch; faces ((4 5 6 7)); }
    inlet  { type patch; faces ((0 4 7 3)); }
    outlet { type patch; faces ((1 2 6 5)); }
    sides  { type patch; faces ((0 1 5 4) (3 7 6 2)); }
);

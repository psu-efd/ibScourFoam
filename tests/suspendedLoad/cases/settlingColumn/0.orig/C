FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      C;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];
internalField   uniform 1e-3;

boundaryField
{
    bed
    {
        type        sedimentBedFlux;
        mode        referenceLevel;     // E = ws Cb* = 0, D = ws C_f
        value       uniform 1e-3;
    }
    top             { type zeroGradient; }
    sides           { type empty; }
}


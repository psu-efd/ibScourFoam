FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     suspendedSedimentFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         400;
deltaT          0.25;           // settling Courant number ws dt/dz = 0.25
writeControl    runTime;
writeInterval   10;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;

functions
{
    // E - D per bed face and the sediment budget (libsuspendedSediment)
    bedExchange
    {
        type        sedimentBedExchange;
        libs        (suspendedSediment);
        writeFields yes;
    }
}


FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


application     ibScourPimpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         400;
deltaT          0.02;
writeControl    runTime;
writeInterval   400;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(p|pFinal)"    { solver PCG; preconditioner DIC; tolerance 1e-8; relTol 0; }
    "(U|UFinal)"    { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-10; relTol 0; }
    // tight tolerance: the budget check is at round-off level
    C               { solver PBiCGStab; preconditioner DILU; tolerance 1e-17; relTol 0; maxIter 200; }
}

PIMPLE
{
    nOuterCorrectors 1;
    nCorrectors     1;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
}


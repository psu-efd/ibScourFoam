FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      immersedBoundaryDict;
}

// The bed as an immersed plane on the face between the two mesh blocks
cutFaces        false;
wallSink        tangential;

solids
{
    bed
    {
        type            plane;
        point           (0 0 0);
        normal          (0 0 1);
    }
}

turbulence { kTreatment equilibrium; }

wallModel
{
    mode            stress;
    reportMaxShear  false;
    wallLaw         { type vanDriest; ks 0.001; }   // Strickler n = ks^(1/6)/26 = 0.0122
}

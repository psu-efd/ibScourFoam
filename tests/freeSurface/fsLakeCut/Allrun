#!/bin/bash
# fsLakeCut: water at rest over a sloping height-field bed with cut-face
# apertures and an immersed cylinder (ibScourInterFoam); spurious velocity,
# water volume and hydrostatic pressure as in fsLakeAtRest. Serial, minutes.
# Usage: ./Allrun [MULES|isoAdvector]
cd "${0%/*}" || exit 1
scheme=${1:-MULES}
rm -rf 0 [1-9]* 0.[0-9]* log.* postProcessing constant/finite-area
cp -r 0.orig 0
sed -i "s/^\(\s*alphaScheme\s*\)[A-Za-z]*;/\1$scheme;/" system/fvSolution
blockMesh > log.blockMesh 2>&1 || { echo "blockMesh failed"; exit 1; }
makeFaMesh > log.makeFaMesh 2>&1 || { echo "makeFaMesh failed"; exit 1; }
setFields > log.setFields 2>&1 || { echo "setFields failed"; exit 1; }
ibScourInterFoam > log.ibScourInterFoam 2>&1
python3 check.py

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     ibScourInterFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2;
deltaT          0.001;
writeControl    adjustableRunTime;
writeInterval   0.5;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable no;
adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       0.002;     // gravity-wave Courant limit on 1 cm cells (0.01 s gives 3e-4 m/s surface noise, also with stock interFoam)

functions
{
    // Spurious velocity in the water: max |U| over the cells with
    // alpha > 0.5 (the solid cells have U = 0)
    waterSpeed
    {
        type            coded;
        libs            (utilityFunctionObjects);
        name            waterSpeed;
        writeControl    timeStep;
        writeInterval   10;
        codeExecute
        #{
            const volVectorField& U =
                mesh().lookupObject<volVectorField>("U");
            const volScalarField& a =
                mesh().lookupObject<volScalarField>("alpha.water");
            scalar uMax = 0;
            forAll(U, i)
            {
                if (a[i] > 0.5) uMax = max(uMax, mag(U[i]));
            }
            reduce(uMax, maxOp<scalar>());
            Info<< "waterSpeed: max |U| in water = " << uMax
                << " m/s" << endl;
        #};
    }
}

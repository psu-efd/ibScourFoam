FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Dam break over a dry mobile sand bed: 2 m x 0.9 m slab, 1 cm cells; the
// sand bed (height field) lies at z = 0.05, five cells above the floor.
scale   1;
vertices
(
    (0 0 0) (2 0 0) (2 0.01 0) (0 0.01 0)
    (0 0 0.9) (2 0 0.9) (2 0.01 0.9) (0 0.01 0.9)
);
blocks ( hex (0 1 2 3 4 5 6 7) (200 1 90) simpleGrading (1 1 1) );
boundary
(
    left   { type wall;  faces ((0 4 7 3)); }
    right  { type wall;  faces ((1 2 6 5)); }
    bottom { type wall;  faces ((0 3 2 1)); }
    top    { type patch; faces ((4 5 6 7)); }
    frontAndBack { type empty; faces ((0 1 5 4) (3 7 6 2)); }
);

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sedimentProperties;
}

solveSediment   yes;
diffusivity     turbulence;     // DC = nu/ScC + nut/sigmaC (laminar: nut = 0)
ScC             1;
sigmaC          1;
d50             0.0001;
s               2.65;
settlingVelocityModel soulsby;
referenceConcentrationModel zysermanFredsoe;
shieldsNumber   total;
ibBedExchange   { mode logLaw; }

#!/bin/bash
# fsDamBreakMobile: dam break over a dry mobile sand bed with bed load and
# suspended load (stage 1b). Pass: no sediment in the air, water volume
# conserved while the bed moves, no transport on the dry bed ahead of the
# bore. Serial, a few minutes. Usage: ./Allrun [MULES|isoAdvector]
cd "${0%/*}" || exit 1
scheme=${1:-MULES}
rm -rf 0 [1-9]* 0.[0-9]* log.* postProcessing
cp -r 0.orig 0
sed -i "s/^\(\s*alphaScheme\s*\)[A-Za-z]*;/\1$scheme;/" system/fvSolution
blockMesh > log.blockMesh 2>&1 || { echo "blockMesh failed"; exit 1; }
setFields > log.setFields 2>&1 || { echo "setFields failed"; exit 1; }
ibScourInterFoam > log.ibScourInterFoam 2>&1
python3 check.py

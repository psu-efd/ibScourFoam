FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// Wave flume 10 m long, water depth 0.2 m, 2 cm x 1 cm cells; the bed is
// the ground wall patch (reference for the immersed-bed run).
scale   1;
vertices
(
    (0 0 0)     (10 0 0)     (10 0.02 0)     (0 0.02 0)
    (0 0 0.35)  (10 0 0.35)  (10 0.02 0.35)  (0 0.02 0.35)
);
blocks ( hex (0 1 2 3 4 5 6 7) (500 1 35) simpleGrading (1 1 1) );
boundary
(
    inlet      { type patch; faces ((0 4 7 3)); }
    outlet     { type patch; faces ((1 2 6 5)); }
    ground     { type wall;  faces ((0 3 2 1)); }
    top        { type patch; faces ((4 5 6 7)); }
    sides      { type empty; faces ((0 1 5 4) (3 7 6 2)); }
);

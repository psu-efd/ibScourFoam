FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      immersedBoundaryDict;
}

// The flume bed as an immersed plane on the face between the two blocks
cutFaces        false;
wallSink        tangential;
solids
{
    bed { type plane; point (0 0 0); normal (0 0 1); }
}
wallModel
{
    mode            stress;
    wallLaw         { type laminar; }
}

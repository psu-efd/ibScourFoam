#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

restore0Dir

runApplication blockMesh

runApplication snappyHexMesh -overwrite

runApplication setExprFields              # initial inflow profile

runApplication decomposePar -no-finite-area

runParallel makeFaMesh                   # bed area mesh

runParallel $(getApplication)

runParallel redistributePar -reconstruct  # (reconstructPar of v2606 fails on area fields)


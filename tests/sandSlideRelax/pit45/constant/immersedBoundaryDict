FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      immersedBoundaryDict;
}
solveFlow       false;      // bed only: the sand slide is the only process

bed
{
    type            heightField;
    floorPatch      bottom;
    initialElevation        // the cone (pit: negative, mound: positive)
    {
        type        expression;
        expression  #{ -0.05*max(0, 1 - mag(vector(pos().x(), pos().y(), 0))/0.05) #};
    }
    openBoundaries  ();

    grainDiameter   0.00026;
    specificGravity 2.65;
    porosity        0.4;
    gravity         9.81;
    criticalShields 0.05;
    frictionCoefficient 0.625;
    bedLoad         engelundFredsoe;

    morphStartTime  0;
    morphFactor     1;
    maxBedChange    1e-3;
    updateDistance  1e-3;

    sandSlide       true;
    slideDiffusivity 5e-4;
    slideTolerance  0.01;
    slideMaxIter    2000;

    prescribedShear             // still water: no bed load
    {
        type        expression;
        expression  #{ vector(0, 0, 0) #};
    }

    seepage
    {
        type        none;
    }
}

cutFaces        true;
wallSink        tangential;

solids
{
}

wallModel
{
    mode            stress;
    wallLaw
    {
        type            vanDriest;
        ks              0.0005;
    }
}

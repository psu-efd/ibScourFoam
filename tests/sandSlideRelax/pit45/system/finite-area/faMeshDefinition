FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      faMeshDefinition;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The bed area mesh (makeFaMesh): the floor patch below the sediment. The
// open boundaries of the bed are named; all other edges are closed.

polyMeshPatches ( bottom );

boundary
{
    inlet  { type patch; neighbourPolyPatch inlet; }
    outlet { type patch; neighbourPolyPatch outlet; }
}

defaultPatch
{
    name    bedBoundary;
    type    patch;
}


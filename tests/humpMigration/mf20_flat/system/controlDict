FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "$FOAM_CASE/system/caseParameters"

application     ibScourPimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         $endTime;

deltaT          $deltaT;

writeControl    runTime;

writeInterval   $writeInterval;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;



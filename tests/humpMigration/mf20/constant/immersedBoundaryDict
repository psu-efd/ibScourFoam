FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      immersedBoundaryDict;
}
bed
{
    type            heightField;
    floorPatch      bottom;
    initialElevation            // the Gaussian hump
    {
        type        expression;
        expression  #{ 0.01*exp(-0.5*sqr((pos().x() - 0.4)/0.05)) #};
    }
    openBoundaries  (inlet outlet);
    fixedBed
    {
        inlet       0.01;       // equilibrium feed: inlet bed kept at z = 0
    }

    grainDiameter   0.00026;
    specificGravity 2.65;
    porosity        0.4;
    gravity         9.81;
    criticalShields 0.05;
    frictionCoefficient 0.625;
    bedLoad         engelundFredsoe;
    bedSlope                    // damps grid-scale bed modes
    {
        model       kochFlokstra;
        alpha       1.5;
    }

    morphStartTime  3.0;  // hydrodynamic spin-up on the fixed bed
    morphFactor     20.0;
    maxBedChange    1e-4;
    updateDistance  5e-4;

    sandSlide       true;
    slideDiffusivity 5e-4;
    slideTolerance  0.02;
    slideMaxIter    500;
}

cutFaces        true;
cutCentroids
{
    skewCorrection  true;
    faceInterpolation true;
    diffusion       true;
    pressure        true;
    wallDistance    true;
}
wallSink        tangential;

solids
{
}

turbulence
{
    kTreatment      equilibrium;
}

wallModel
{
    mode            stress;

    wallLaw
    {
        type            spalding;   // hydraulically smooth bed
    }
}

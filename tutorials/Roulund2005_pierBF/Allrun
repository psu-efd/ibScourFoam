#!/bin/bash
# -----------------------------------------------------------------------------
# Allrun: live-bed scour at a vertical pier, Roulund et al. (2005),
# body-fitted bed (stock pimpleFoam + the deformingBed function object of
# libibScour, layered mesh motion)
#
# The case is generated by tests/bodyFittedPier/make_case.py: an O-grid of
# 128 x 30 cells around the pier (first cells 2.2 mm radial, 1 mm vertical),
# the inflow of the immersed-bed tutorial (../Roulund2005_pierIB), 5 s of flow
# on the fixed bed, then the mobile bed with morphological factor 2 and a
# bed-load adaptation length of 10 d50 up to t = 155 s (300 s of
# morphological time); about 6.5 h on 48 ranks (Intel Ice Lake).
#
# Usage:
#     ./Allrun                 # NP=48, run directory ./run
#     NP=64 RUN_DIR=/scratch/pierBF ./Allrun
#
# Requirements: OpenFOAM v2606 with ibScourFoam built, Python >= 3.8 with
# numpy ($PYTHON, default python3).
# -----------------------------------------------------------------------------

cd "${0%/*}" || exit 1
HERE=$PWD
NP=${NP:-48}
PYTHON=${PYTHON:-python3}
RUN=${RUN_DIR:-$HERE/run}
GEN=$HERE/../../tests/bodyFittedPier/make_case.py
if [ -e "$RUN" ]
then
    echo "$RUN exists; remove it (./Allclean) or set RUN_DIR" >&2
    exit 1
fi
set -e

$PYTHON "$GEN" setup --run-dir "$RUN" --inflow "$HERE/../Roulund2005_pierIB" \
    --mode live --dr 2.2e-3 --dz 1e-3 --n-r 30 --nz 45 \
    --end-time 155 --write-interval 2.5 --morph-factor 2 --morph-start 5 \
    --np "$NP" > "$HERE/log.setup" 2>&1
blockMesh -case "$RUN" > "$RUN/log.blockMesh" 2>&1
$PYTHON "$GEN" init --run-dir "$RUN" >> "$HERE/log.setup" 2>&1
cd "$RUN"
decomposePar > log.decomposePar 2>&1
mpirun -np "$NP" --bind-to core pimpleFoam -parallel > log.pimpleFoam 2>&1
echo "finished: $RUN (bed in postProcessing, wallShearStress on patch bed)"

#------------------------------------------------------------------------------

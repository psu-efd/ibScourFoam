FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Live-bed scour at a vertical pier, Roulund et al. (2005): 20 s of flow on
// the fixed bed, then the mobile bed with morphological factor 2
// (constant/immersedBoundaryDict): t = 170 s is 300 s of morphological time.

application     ibScourPimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         170;

deltaT          0.002;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       0.002;

writeControl    adjustableRunTime;

writeInterval   5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

// ************************************************************************* //
